{% endfor %}

## 3. Key findings

{% for s in r.subjects %}
{% if s.findings %}
### {{ s.name | esc }}{% if s.role %} — {{ s.role | esc }}{% endif %}

{% for f in s.findings %}
{{ finding(f) | trim }}

{% endfor %}
{% endif %}
