| {{ row.subject | esc }} | {{ labels.get(row.category, row.category) | replace("_", " ") | title | esc }} | {{ row.high }} | {{ row.medium }} | {{ row.low }} | {% for id in row.claim_ids %}`{{ id }}`{{ ", " if not loop.last }}{% endfor %} |
