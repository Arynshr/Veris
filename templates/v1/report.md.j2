```jinja2
{% set bg = r.meta.research_mode == "background_check" %}
{% set labels = {
  "criminal": "Criminal Records",
  "regulatory_sanctions": "Regulatory & Sanctions",
  "litigation": "Legal Proceedings",
  "financial_crime_fraud": "Financial Crime & Fraud",
  "corruption_bribery": "Corruption & Bribery",
  "esg_labor_safety": "ESG, Labor & Safety",
  "reputational": "Reputational & Other"
} %}
{% set c = r.coverage %}
{% set refs = namespace(by_claim={}) %}

{# Build stable reference IDs for this report. #}
{% for a in r.appendix %}
  {% if a.claim_id and a.claim_id not in refs.by_claim %}
    {% set _ = refs.by_claim.update({a.claim_id: "R" ~ loop.index}) %}
  {% endif %}
{% endfor %}

{% macro reference_ids(f) %}
  {% if f.claim_id in refs.by_claim %}
    [{{ refs.by_claim[f.claim_id] }}]
  {% else %}
    Reference pending
  {% endif %}
{% endmacro %}

{% macro finding(f) %}
#### {{ f.text | esc }}

{% if f.event_date %}
**Event date:** {{ f.event_date }}
{% elif f.undated %}
**Event date:** Unknown
{% endif %}
{% if f.severity %}
**Evidence assessment:** {{ f.severity | title }}
{% endif %}
{% if f.legal_status and f.legal_status != "unknown" %}
**Reported legal status:** {{ f.legal_status | replace("_", " ") | title }}
{% endif %}
{% if f.verification == "SINGLE_SOURCE" %}
**Corroboration:** Single source; not independently corroborated.
{% endif %}
{% if f.conflicts_with %}
**Conflicting evidence:** Other claims require reconciliation ({{ f.conflicts_with | join(", ") }}). This finding should not be treated as settled.
{% endif %}
**Reference:** {{ reference_ids(f) | trim }}
{% if f.source %}
<text>{{ f.source | esc }}</text>
{% endif %}

{% endmacro %}

# {{ "Background Check Report" if bg else "Research Intelligence Report" }}

**Subject / research request:** {{ r.meta.query | esc }}

**Report date:** {{ c.as_of }}

**Review period:** {{ c.window_start }} to {{ c.as_of }}

**Report status:** {% if c.degraded %}Limited — see coverage and limitations{% else %}Completed — subject to stated limitations{% endif %}

{% if bg %}
> **Important:** This report is an information-screening aid, not a legal determination, finding of misconduct, or substitute for independent verification. An absence of reported findings does not establish that no relevant records exist.
{% endif %}

---

