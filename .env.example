# Search Providers
TAVILY_API_KEY=your_tavily_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key
SEARXNG_BASE_URL=http://localhost:8080

# Query Understanding, Planning & Synthesis
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=model

# Retrieval Limits
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_QUERIES_PER_PLAN=6
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Background Check Mode Tuning
ADVERSE_LOOKBACK_DAYS=730
MIN_SUBJECT_NAME_OVERLAP=0.6
MAX_RESOLVED_SUBJECTS=8

# Output
RUNS_DIR=runs
